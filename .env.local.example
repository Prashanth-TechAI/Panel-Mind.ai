# =============================================================================
#  PanelMind AI — environment template
# =============================================================================
#
#  HOW TO USE
#    cp .env.local.example .env
#
#  Copy it to `.env` in the project root — NOT `.env.local`. The backend and
#  the voice worker only read `.env` (backend/app/config.py), and the frontend
#  reads it too. Never commit the filled-in file; `.env*` is gitignored.
#
#  REQUIRED  = the API refuses to start without it.
#  OPTIONAL  = has a working default, or the feature degrades honestly.
#
#  Check everything is wired once the API is up:
#    curl "http://127.0.0.1:8000/api/health?deep=1"
# =============================================================================


# -----------------------------------------------------------------------------
#  LLM — hot path (live interview turns; must be fast)          console.groq.com
# -----------------------------------------------------------------------------
# REQUIRED
GROQ_API_KEY=

# OPTIONAL. The model must exist on YOUR Groq account — list yours with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# If it is missing, the board stays silent in the room and /api/health says so.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SUMMARY_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1


# -----------------------------------------------------------------------------
#  LLM — cold path (board preparation + evaluation; must be smart) openrouter.ai
# -----------------------------------------------------------------------------
# REQUIRED
OPENROUTER_API_KEY=

# OPTIONAL
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_RETRIES=3


# -----------------------------------------------------------------------------
#  Speech
# -----------------------------------------------------------------------------
# REQUIRED — speech-to-text, and fallback voice                  deepgram.com
DEEPGRAM_API_KEY=

# REQUIRED — the board members' voices                         elevenlabs.io
ELEVENLABS_API_KEY=

# OPTIONAL — voice character, each 0.0 to 1.0
ELEVENLABS_STYLE=0.45
ELEVENLABS_STABILITY=0.55

# OPTIONAL — voice provider order; first healthy one wins (elevenlabs, deepgram)
TTS_PROVIDER_CHAIN=elevenlabs,deepgram


# -----------------------------------------------------------------------------
#  Realtime transport (the interview room)                 cloud.livekit.io
# -----------------------------------------------------------------------------
# REQUIRED. The URL must start with wss://
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=


# -----------------------------------------------------------------------------
#  Database
# -----------------------------------------------------------------------------
# OPTIONAL. Leave empty to use on-disk JSON files instead (fine for trying it
# out and for tests). The schema is created automatically on API startup.
#   createdb panelmind
DATABASE_URL=postgresql://localhost/panelmind


# -----------------------------------------------------------------------------
#  Embeddings — DAF retrieval                                     voyageai.com
# -----------------------------------------------------------------------------
# OPTIONAL
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-lite


# -----------------------------------------------------------------------------
#  WhatsApp updates (Meta Cloud API)
# -----------------------------------------------------------------------------
# OPTIONAL. Left empty, the app still records an aspirant's opt-in but sends
# nothing — and says so in the UI instead of pretending.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_BUSINESS_NUMBER=


# -----------------------------------------------------------------------------
#  Runtime
# -----------------------------------------------------------------------------
# OPTIONAL. development | test | production
ENVIRONMENT=development
# OPTIONAL. trace | debug | info | warn | error
LOG_LEVEL=info

# OPTIONAL. Browser origins allowed to call the API — must include wherever
# the frontend runs (`npm run dev` serves on port 3100).
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100


# -----------------------------------------------------------------------------
#  Ports — only change these if 8000 is already taken on your machine
# -----------------------------------------------------------------------------
# Where the frontend and the voice worker find the API. Both default to
# http://127.0.0.1:8000; set both if you start uvicorn on another port.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# BOARD_API_URL=http://127.0.0.1:8000
